# BLAXIN Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# ── Domain & SSL ────────────────────────────────────────────────
# Set your domain for HTTPS (leave as localhost for HTTP-only)
DOMAIN=localhost
# Email for Let's Encrypt certificate notifications (required for SSL)
CERTBOT_EMAIL=

# ── API Keys ────────────────────────────────────────────────────
# At least one provider key is needed for the AI agent to work.
# In a distributed setup these keys belong to the BRAIN device only —
# they are never sent to BLAXIN Bodies.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# ── Standalone Brain (external mode) ────────────────────────────
# Active AI provider/model for the Brain process (cd server && npm run brain):
BLAXIN_BRAIN_PROVIDER=
BLAXIN_BRAIN_MODEL=
# Serve the Brain over WSS only — PEM file paths (both required for TLS):
BLAXIN_BRAIN_TLS_KEY=
BLAXIN_BRAIN_TLS_CERT=
# Body: CA that signed the Brain's certificate (private/self-signed LAN):
BLAXIN_BRAIN_CA_FILE=
# Body: DO NOT set unless doing local development — allows plaintext ws://
# to non-loopback Brains and skips certificate checks:
BLAXIN_BRAIN_ALLOW_INSECURE=

# ── Security ────────────────────────────────────────────────────
# Encryption key for stored credentials
# Generate with: openssl rand -hex 32
BLAXIN_SECRET=

# ── Backend origin allowlist ─────────────────────────────────────
# For remote web deployments (DOMAIN set to a public host), list the
# public origin(s) that may talk to the API, e.g.:
#   BLAXIN_ALLOWED_ORIGINS=https://blaxin.example.com
# Leave empty when running locally (localhost + desktop are allowed).
BLAXIN_ALLOWED_ORIGINS=
